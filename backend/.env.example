# PostgreSQL
DATABASE_URL=postgresql://chess:chess123@localhost:5432/chessweb

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# App
PORT=3100
NODE_ENV=development

# Allowed browser origin(s). One origin, or a comma-separated list.
# "*" reflects ANY origin back with credentials:true — every site can then read
# authenticated API responses. Throwaway tunnel demos only; never deploy it.
# The server logs a [SECURITY] warning on boot when it is set to "*".
CORS_ORIGIN=http://localhost:5173

# Host used to build friend-challenge share links. Falls back to CORS_ORIGIN,
# then http://localhost:5173.
FRONTEND_URL=http://localhost:5173
